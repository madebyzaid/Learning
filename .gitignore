# ---------- compiled binaries without extension (gcc/g++ -o name) ----------
# Ignore every extensionless file, then re-allow directories,
# anything with an extension, and common extensionless project files.
*
!*/
!*.*
!README
!LICENSE
!Makefile
!Dockerfile

# ---------- re-ignore after the whitelist above (order matters) ----------
# compiled output
*.exe
*.out
*.o
*.obj
*.a
*.so
*.bin

# images
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp

# videos
*.mp4
*.avi
*.mkv
*.mov
*.webm

# AI / ML models and exported model folders
*.pt
*.pth
*.onnx
*.h5
*.weights
*.param
*_ncnn_model/

# datasets
*.csv

# python / environment junk
__pycache__/
*.pyc
myenv/
venv/
.venv/
.ipynb_checkpoints/

# Windows download markers
*:Zone.Identifier
*Zone.Identifier